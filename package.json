{
  "name": "excel-facil",
  "productName": "Excel Fácil",
  "version": "1.0.0",
  "description": "Editor de planilhas simples, offline e em português",
  "main": "dist-electron/main.js",
  "license": "MIT",
  "author": "Excel Fácil",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build-main.mjs",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "test:e2e": "npm run build && node tests/e2e/run.mjs",
    "icon": "node scripts/make-icon.mjs",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {},
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.58.0",
    "playwright-core": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "zustand": "^5.0.15"
  },
  "allowScripts": {
    "electron@44.8.0": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.2": true
  },
  "build": {
    "appId": "br.com.excelfacil.app",
    "productName": "Excel Fácil",
    "executableName": "ExcelFacil",
    "copyright": "Excel Fácil",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "!dist-electron/meta.json",
      "build/icon.png",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "ExcelFacil-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "Excel Fácil",
      "uninstallDisplayName": "Excel Fácil",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerLanguages": [
        "pt_BR"
      ],
      "language": "1046",
      "include": "build/installer.nsh",
      "deleteAppDataOnUninstall": false
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    }
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
